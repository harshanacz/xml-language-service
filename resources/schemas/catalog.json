{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.1.0",
  "schemas": [
    {
      "id": "maven-4.0.0",
      "domain": "build",
      "pattern": "**/pom.xml",
      "namespaces": [
        "http://maven.apache.org/POM/4.0.0"
      ],
      "systemIds": [
        "http://maven.apache.org/xsd/maven-4.0.0.xsd",
        "https://maven.apache.org/xsd/maven-4.0.0.xsd"
      ],
      "path": "build/maven-4.0.0.xsd"
    },
    {
      "id": "servlet-web-app-3.1",
      "domain": "javaee",
      "pattern": "**/web.xml",
      "namespaces": [
        "http://xmlns.jcp.org/xml/ns/javaee"
      ],
      "systemIds": [
        "http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd",
        "https://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
      ],
      "path": "javaee/web-app_3_1.xsd"
    },
    {
      "id": "jpa-persistence-2.2",
      "domain": "javaee",
      "pattern": "**/persistence.xml",
      "namespaces": [
        "http://xmlns.jcp.org/xml/ns/persistence"
      ],
      "systemIds": [
        "http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
      ],
      "path": "javaee/persistence_2_2.xsd"
    },
    {
      "id": "spring-beans",
      "domain": "frameworks",
      "pattern": "**/spring-*.xml",
      "namespaces": [
        "http://www.springframework.org/schema/beans"
      ],
      "systemIds": [
        "http://www.springframework.org/schema/beans/spring-beans.xsd",
        "http://www.springframework.org/schema/beans/spring-beans-4.3.xsd"
      ],
      "path": "frameworks/spring-beans-4.3.xsd"
    }
  ]
}
