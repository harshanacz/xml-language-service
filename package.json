{
  "name": "xml-language-service",
  "version": "1.2.0",
  "description": "Editor-agnostic XML language service with fault-tolerant parsing, XSD validation (Xerces-C++ WASM), completions, hover, symbols, folding, formatting, rename, definition and references.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r resources dist/resources",
    "build:watch": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "keywords": [
    "xml",
    "language-service",
    "xsd",
    "validation",
    "completion",
    "lsp",
    "xerces",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/harshanacz/xml-language-service.git"
  },
  "bugs": {
    "url": "https://github.com/harshanacz/xml-language-service/issues"
  },
  "homepage": "https://github.com/harshanacz/xml-language-service#readme",
  "license": "MIT",
  "dependencies": {
    "@xml-tools/parser": "^1.0.11",
    "xerces-wasm": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
